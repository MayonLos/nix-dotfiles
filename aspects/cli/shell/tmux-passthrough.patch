+/* Check for one complete OSC 11 or OSC 111 background-color sequence. */
+static int
+screen_write_is_osc_bg(const u_char *str, u_int len)
+{
+	u_int	i, start, end;
+	int	reset;
+
+	start = 5;
+	if (len >= 5 && memcmp(str, "\033]11;", 5) == 0)
+		reset = 0;
+	else if (len >= 5 && memcmp(str, "\033]111", 5) == 0)
+		reset = 1;
+	else
+		return (0);
+
+	if (len > start && str[len - 1] == '\007')
+		end = len - 1;
+	else if (len >= start + 2 && str[len - 2] == '\033' &&
+	    str[len - 1] == '\\')
+		end = len - 2;
+	else
+		return (0);
+
+	if (reset)
+		return (end == start);
+	if (end == start)
+		return (0);
+	for (i = start; i < end; i++) {
+		if (str[i] < 0x20 || str[i] > 0x7e)
+			return (0);
+	}
+	return (1);
+}
