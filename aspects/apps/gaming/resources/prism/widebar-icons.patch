+// Prism's page actions have no icons, so Fusion centers their labels. Give them
+// the icons used by the main-window toolbars; a blank fallback keeps labels aligned.
+static QIcon wideBarFallbackIcon(const QAction* action)
+{
+    static const QHash<QString, QString> names{
+        { "actionDownloadItem", "new" },        { "actionAddItem", "new" },
+        { "actionAdd", "new" },                 { "actionAddMicrosoft", "new" },
+        { "actionAddOffline", "new" },          { "actionAdd_Empty", "new" },
+        { "actionUpdateItem", "checkupdate" },  { "actionChangeVersion", "tag" },
+        { "actionChange_version", "tag" },      { "actionRemoveItem", "delete" },
+        { "actionRemove", "delete" },           { "actionDelete", "delete" },
+        { "actionEnableItem", "status-good" },  { "actionDisableItem", "status-bad" },
+        { "actionViewHomepage", "news" },       { "actionExportMetadata", "export" },
+        { "actionViewFolder", "viewfolder" },   { "actionView_Folder", "viewfolder" },
+        { "actionMinecraftFolder", "viewfolder" }, { "actionLibrariesFolder", "viewfolder" },
+        { "actionViewConfigs", "settings" },    { "actionRename", "rename" },
+        { "actionCopy", "copy" },               { "actionRefresh", "refresh" },
+        { "actionReload", "refresh" },          { "actionJoin", "launch" },
+        { "actionManageSkins", "accounts" },    { "actionData_Packs", "datapacks" },
+    };
+    if (const auto name = names.value(action->objectName()); !name.isEmpty())
+        return QIcon::fromTheme(name);
+    QPixmap blank(16, 16);
+    blank.fill(Qt::transparent);
+    return QIcon(blank);
+}
