+/** Append path as one safely quoted POSIX shell word. */
+static bool append_shell_quoted(const char* path, char** cmd)
+{
+    if (!str_append("'", 1, cmd)) {
+        return false;
+    }
+    for (const char* it = path; *it; ++it) {
+        if (*it == '\'') {
+            if (!str_append("'\\''", 0, cmd)) {
+                return false;
+            }
+        } else if (!str_append(it, 1, cmd)) {
+            return false;
+        }
+    }
+    return str_append("'", 1, cmd) != NULL;
+}
