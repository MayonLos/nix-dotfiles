#!/usr/bin/env bash
set -u

systemctl='@SYSTEMCTL@'

if [[ $# -lt 1 ]]; then
  printf '%s\n' 'hyprland-session: missing start-hyprland executable' >&2
  exit 64
fi

launcher=$1
shift

unit_active() {
  "$systemctl" --user is-active --quiet "$1"
}

if unit_active mango-session.target ||
  unit_active hyprland-session.target ||
  unit_active graphical-session.target; then
  printf '%s\n' 'hyprland-session: another graphical session is already active for this user' >&2
  exit 1
fi

child_pid=
received_signal=
forward_signal() {
  received_signal=$1
  if [[ -n $child_pid ]]; then
    kill -s "$1" "$child_pid" 2>/dev/null || true
  fi
}
trap 'forward_signal TERM' TERM
trap 'forward_signal INT' INT

"$launcher" "$@" &
child_pid=$!
if [[ -n $received_signal ]]; then
  kill -s "$received_signal" "$child_pid" 2>/dev/null || true
fi

while :; do
  # Bash interrupts wait when a trap runs. Wait again even if the child has
  # already exited meanwhile: its cached status remains available to wait.
  received_signal=
  wait "$child_pid"
  launcher_status=$?
  [[ -n $received_signal ]] || break
done
child_pid=
trap - TERM INT

# A Mango session may have started while the launcher was running. Never let
# this optional session tear down its shared graphical target.
if ! unit_active mango-session.target; then
  "$systemctl" --user stop hyprland-session.target graphical-session.target || true
  "$systemctl" --user unset-environment HYPRLAND_INSTANCE_SIGNATURE || true
fi

exit "$launcher_status"
