+// R52: absent telemetry contributes no empty or invented information row.
+std::unique_ptr<Flex> HomeTab::createInformationRows() {
+  const float s = contentScale();
+  auto rows = ui::column({.align = FlexAlign::Stretch, .fillWidth = true});
+  auto add = [&](const std::string& title, Flex** row, Label** value) {
+    auto block = ui::column({.out = row, .align = FlexAlign::Stretch, .fillWidth = true});
+    block->addChild(ui::column({.fill = colorSpecFromRole(ColorRole::OutlineVariant, 0.35F), .fillWidth = true, .height = 1.0F * s}));
+    auto button = ui::button({.text = title, .fontSize = 13.0F * s,
+      .variant = ButtonVariant::Ghost, .padding = 8.0F * s,
+      .onClick = [this, title] {
+        if (title == "性能模式") {
+          if (m_services.powerProfiles != nullptr) (void)m_services.powerProfiles->cycleActiveProfile();
+        } else if (title == "Clash 流量") {
+          for (auto& pad : m_shortcutPads) if (pad.shortcut->id() == "clash") pad.shortcut->onClick();
+        } else {
+          PanelManager::instance().togglePanel("control-center", PanelOpenRequest{.context = "power"});
+        }
+      },
+      .configure = [](Button& rowButton) {
+        rowButton.setDirection(FlexDirection::Horizontal);
+        if (rowButton.label() != nullptr) rowButton.label()->setFlexGrow(1.0F);
+      }});
+    button->addChild(ui::label({.out = value, .text = "", .fontSize = 13.0F * s,
+      .color = colorSpecFromRole(ColorRole::OnSurfaceVariant), .textAlign = TextAlign::End}));
+    block->addChild(std::move(button));
+    rows->addChild(std::move(block));
+  };
+  add("电池", &m_batteryRow, &m_batteryValue);
+  add("性能模式", &m_profileRow, &m_profileValue);
+  add("Clash 流量", &m_trafficRow, &m_trafficValue);
+  syncInformationRows();
+  return rows;
+}
+
+void HomeTab::syncInformationRows() {
+  auto set = [](Flex* row, Label* value, const std::string& text) {
+    if (row == nullptr || value == nullptr) return;
+    row->setVisible(!text.empty());
+    row->setParticipatesInLayout(!text.empty());
+    value->setText(text);
+  };
+  std::string battery;
+  if (m_upower != nullptr && m_upower->state().isPresent) {
+    const auto& state = m_upower->state();
+    battery = std::format("{}% · {}", static_cast<int>(std::lround(state.percentage)), batteryStateLabel(state.state));
+  }
+  set(m_batteryRow, m_batteryValue, battery);
+  std::string profile;
+  if (m_services.powerProfiles != nullptr && m_services.powerProfiles->hasStateSnapshot()) {
+    profile = profileLabel(m_services.powerProfiles->activeProfile());
+  }
+  set(m_profileRow, m_profileValue, profile);
+  std::string traffic;
+  for (const auto& pad : m_shortcutPads) {
+    if (pad.shortcut->id() == "clash") traffic = static_cast<ClashShortcut&>(*pad.shortcut).traffic();
+  }
+  set(m_trafficRow, m_trafficValue, traffic);
 }

