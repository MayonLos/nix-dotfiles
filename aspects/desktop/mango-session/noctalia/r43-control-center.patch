+  // R52: the helper exports a tiny allow-listed read-only snapshot, never secrets.
+  // Lifecycle stays in the existing TUI, which owns confirmation/backend safety.
+  class ClashShortcut final : public Shortcut {
+    struct State {
+      std::string label = "正在检测";
+      std::string traffic;
+      bool active = false;
+      bool pending = false;
+      std::chrono::steady_clock::time_point next;
+    };
+    std::shared_ptr<State> m_state = std::make_shared<State>();
+  public:
+    std::string_view id() const override { return "clash"; }
+    std::string defaultLabel() const override { return "Clash"; }
+    std::string displayLabel() const override { return m_state->label; }
+    std::string_view iconOn() const override { return "network"; }
+    std::string_view iconOff() const override { return "network"; }
+    bool isToggle() const override { return true; }
+    bool active() const override { return m_state->active; }
+    const std::string& traffic() const { return m_state->traffic; }
+    void onClick() override {
+      DeferredCall::callLater([] {
+        PanelManager::instance().closePanel();
+        (void)process::runAsync(std::vector<std::string>{"@R52_CLASH_OPEN@"});
+      });
+    }
+    void onRightClick() override { onClick(); }
+    void poll() {
+      const auto now = std::chrono::steady_clock::now();
+      if (m_state->pending || now < m_state->next) return;
+      m_state->pending = true;
+      m_state->next = now + std::chrono::seconds(2);
+      const auto state = m_state;
+      const bool launched = process::runAsync(
+          std::vector<std::string>{"@R52_CLASH_STATUS@"},
+          {.onExit = [state](process::RunResult result) {
+            DeferredCall::callLater([state, result = std::move(result)] {
+              state->pending = false;
+              state->active = false;
+              state->label = "状态不可用";
+              state->traffic.clear();
+              const auto data = nlohmann::json::parse(result.out, nullptr, false);
+              if (result && data.is_object()) {
+                state->label = data.value("label", std::string("状态不可用"));
+                state->active = data.value("active", false);
+                state->traffic = data.value("traffic", std::string{});
+              }
+              PanelManager::instance().requestUpdateOnly();
+            });
+          }},
+          {.timeout = std::chrono::milliseconds(2500), .maxOutputBytes = 4096});
+      if (!launched) { m_state->pending = false; m_state->label = "状态不可用"; }
+    }
+  };

