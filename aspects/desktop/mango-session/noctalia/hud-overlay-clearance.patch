+#pragma once
+
+#include <algorithm>
+
+namespace shell::overlay_clearance {
+// HUD33: output-local logical coordinates; no desktop-global origins or scale multiplication.
+struct Rect {
+  float x = 0, y = 0, w = 0, h = 0;
+  bool operator==(const Rect&) const = default;
+};
+struct Offset {
+  float down = 0, left = 0;
+  bool suppressTooltip = false;
+};
+inline bool overlaps(Rect a, Rect b) {
+  return a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h;
+}
+inline Rect swept(Rect target, float currentY) {
+  const float top = std::min(target.y, currentY);
+  return {target.x, top, target.w, std::max(target.y, currentY) + target.h - top};
+}
+inline Offset resolve(Rect tooltip, Rect stack, float screenWidth, float screenHeight, float gap) {
+  if (!overlaps(tooltip, stack)) return {};
+  const float down = std::max(0.0F, tooltip.y + tooltip.h + gap - stack.y);
+  if (stack.y + stack.h + down <= screenHeight - gap) return {down, 0, false};
+  const float left = std::max(0.0F, stack.x + stack.w + gap - tooltip.x);
+  if (stack.x - left >= gap && stack.x + stack.w - left <= screenWidth - gap)
+    return {0, left, false};
+  return {0, 0, true};
+}
+} // namespace shell::overlay_clearance
