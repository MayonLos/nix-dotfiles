+// HUD33: move the layer surface, not cards: countdowns, hover owners and reply inputs survive.
+void NotificationToast::scheduleOverlayClearance() {
+  if (m_overlayClearanceTimer.active()) return;
+  m_overlayClearanceTimer.start(std::chrono::milliseconds(0), [this] { updateOverlayClearance(); });
+}
+
+void NotificationToast::updateOverlayClearance() {
+  if (m_config == nullptr || m_wayland == nullptr || notificationPosition() != "top_right") return;
+  const auto& cfg = m_config->config().notification;
+  const float scale = notificationUiScale(m_config);
+  const auto base = toastSurfaceMargins(notificationPosition(), std::max(0, cfg.offsetX), std::max(0, cfg.offsetY), scale);
+  const auto occupancy = TooltipManager::instance().systemOccupancy();
+  for (auto& inst : m_instances) {
+    if (inst->surface == nullptr) continue;
+    const auto* output = m_wayland->findOutputByWl(inst->output);
+    if (output == nullptr) continue;
+    const float screenW = output->effectiveLogicalWidth();
+    const float screenH = output->effectiveLogicalHeight();
+    float top = screenH, bottom = 0;
+    // Base coordinates deliberately ignore current margins, preventing feedback loops.
+    // clipHeight is per-output actual height; shared entry.height is not authoritative.
+    for (std::size_t i = 0; i < inst->cards.size(); ++i) {
+      const auto& card = inst->cards[i];
+      if (card.cardNode == nullptr) continue;
+      const float y = cardSurfaceY(*inst, i);
+      // Include animation position as well as its target: collapsing/exiting cards
+      // can still occupy the old slot when a new tooltip appears.
+      const auto span = shell::overlay_clearance::swept(
+          {0, y, 0, card.clipHeight}, card.cardNode->y());
+      top = std::min(top, span.y);
+      bottom = std::max(bottom, span.y + span.h);
+    }
+    shell::overlay_clearance::Offset offset;
+    if (occupancy.output == inst->output && bottom > top) {
+      const shell::overlay_clearance::Rect stack{
+          screenW - base.right - inst->surface->width(), base.top + top,
+          static_cast<float>(inst->surface->width()), bottom - top};
+      offset = shell::overlay_clearance::resolve(occupancy.rect, stack, screenW, screenH, 12.0F);
+      if (offset.suppressTooltip || (inst->pointerInside && (offset.down > 0 || offset.left > 0))) {
+        TooltipManager::instance().suppressSystemForCurrentHover();
+        offset = {};
+      }
+    }
+    // Never move an interactive notification away from the pointer. Restore after leave.
+    if (inst->pointerInside) continue;
+    const auto dy = static_cast<int>(std::ceil(offset.down));
+    const auto dx = static_cast<int>(std::ceil(offset.left));
+    if (inst->surface->marginTop() != base.top + dy || inst->surface->marginRight() != base.right + dx
+        || inst->surface->marginBottom() != base.bottom - dy || inst->surface->marginLeft() != base.left) {
+      // Top+bottom sum unchanged: no viewport shrink, card rebuild or clipping.
+      inst->surface->setMargins(base.top + dy, base.right + dx, base.bottom - dy, base.left);
+    }
+  }
+}
