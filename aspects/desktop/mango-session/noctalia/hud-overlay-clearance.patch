+void TooltipManager::updateSystemOccupancy() {
+  Occupancy next;
+  if (m_surface != nullptr && m_activeLayerParent != nullptr && m_activeOutput != nullptr) {
+    if (m_state == State::FadingOut) return; // reserve through the final fade frame
+    const auto* panel = std::get_if<TooltipPanel>(&m_pendingContent);
+    const auto* output = m_wayland->findOutputByWl(m_activeOutput);
+    const auto* parent = static_cast<const LayerSurface*>(zwlr_layer_surface_v1_get_user_data(m_activeLayerParent));
+    if (panel != nullptr && panel->title == "SYSTEM" && output != nullptr && parent != nullptr
+        && (parent->anchor() & LayerShellAnchor::Top) != 0
+        && (parent->anchor() & LayerShellAnchor::Bottom) == 0) {
+      const float outputWidth = output->effectiveLogicalWidth();
+      const auto anchors = parent->anchor();
+      float parentX = (outputWidth - parent->width()) * 0.5F;
+      if ((anchors & LayerShellAnchor::Left) != 0) parentX = parent->marginLeft();
+      else if ((anchors & LayerShellAnchor::Right) != 0)
+        parentX = outputWidth - parent->width() - parent->marginRight();
+      next = {m_activeOutput, {parentX + m_surface->configuredX(),
+          static_cast<float>(parent->marginTop() + m_surface->configuredY()),
+          static_cast<float>(m_surface->width()), static_cast<float>(m_surface->height())}};
+    }
+  }
+  if (next == m_systemOccupancy) return;
+  m_systemOccupancy = next;
+  m_systemOccupancyChanged.emit();
+}
