+  [[nodiscard]] std::string readFirstLine(const std::filesystem::path& path) {
+    std::ifstream input(path);
+    std::string value;
+    std::getline(input, value);
+    return value;
+  }
+
+  // UI4: lockscreen palette-gradient password underline and cached runtime status.
+  [[nodiscard]] std::string lockscreenRuntimeStatus() {
+    using Clock = std::chrono::steady_clock;
+    static auto lastRead = Clock::time_point{};
+    static std::string cached;
+    const auto now = Clock::now();
+    if (!cached.empty() && now - lastRead < std::chrono::seconds{5}) {
+      return cached;
+    }
+    lastRead = now;
+
+    std::string username = "unknown";
+    if (const passwd* account = getpwuid(getuid()); account != nullptr && account->pw_name != nullptr) {
+      username = account->pw_name;
+    }
+    std::array<char, 256> host{};
+    if (gethostname(host.data(), host.size() - 1) != 0 || host.front() == '\0') {
+      host[0] = '?';
+    }
+    utsname system{};
+    const std::string kernel = uname(&system) == 0 ? system.release : "unknown";
+
+    std::string power = "power n/a";
+    std::string care = "养护 --";
+    std::optional<bool> conservationMode;
+    bool conflictingConservationModes = false;
+    std::error_code modeError;
+    const std::filesystem::path ideapadDevices{"/sys/bus/platform/drivers/ideapad_acpi"};
+    for (std::filesystem::directory_iterator it(ideapadDevices, modeError), end;
+         !modeError && it != end; it.increment(modeError)) {
+      const std::string mode = readFirstLine(it->path() / "conservation_mode");
+      if (mode != "0" && mode != "1") {
+        continue;
+      }
+      const bool enabled = mode == "1";
+      if (conservationMode.has_value() && *conservationMode != enabled) {
+        conflictingConservationModes = true;
+      } else {
+        conservationMode = enabled;
+      }
+    }
+    const bool haveConservationMode =
+        !modeError && conservationMode.has_value() && !conflictingConservationModes;
+    if (haveConservationMode) {
+      care = *conservationMode ? "养护 on" : "养护 off";
+    }
+
+    // UI4: ideapad_acpi conservation status precedes the standard battery limit fallback.
+    std::error_code error;
+    const std::filesystem::path supplies{"/sys/class/power_supply"};
+    for (std::filesystem::directory_iterator it(supplies, error), end; !error && it != end; it.increment(error)) {
+      const auto type = readFirstLine(it->path() / "type");
+      if (type != "Battery") {
+        continue;
+      }
+      const std::string chargeLimit = readFirstLine(it->path() / "charge_control_end_threshold");
+      if (!haveConservationMode && !chargeLimit.empty()) {
+        try {
+          const int limit = std::stoi(chargeLimit);
+          if (limit >= 1 && limit <= 100) {
+            care = limit <= 80 ? std::format("养护 ≤{}%", limit) : std::format("养护 off {}%", limit);
+          }
+        } catch (const std::exception&) {
+          care = "养护 --";
+        }
+      }
+
+      const std::string capacityText = readFirstLine(it->path() / "capacity");
+      const std::string state = readFirstLine(it->path() / "status");
+      try {
+        const int capacity = std::stoi(capacityText);
+        if (capacity < 0 || capacity > 100) {
+          throw std::invalid_argument("battery capacity out of range");
+        }
+        const int lit = (capacity + 9) / 10;
+        power = std::format("bat [{}{}] {}% {}", std::string(static_cast<std::size_t>(lit), '#'),
+                            std::string(static_cast<std::size_t>(10 - lit), '.'), capacity,
+                            state.empty() ? "state n/a" : state);
+      } catch (const std::exception&) {
+        power = "bat [..........] n/a";
+      }
+      break;
+    }
+    cached = std::format("{}@{} | Linux {} | {} | {}", username, host.data(), kernel, power, care);
+    return cached;
+  }
+
+  [[nodiscard]] RoundedRectStyle passwordAccentStyle(bool glow) {
+    const Color primary = resolveColorSpec(colorSpecFromRole(ColorRole::Primary));
+    const Color secondary = resolveColorSpec(colorSpecFromRole(ColorRole::Secondary));
+    const float alpha = glow ? 0.22F : 1.0F;
+    RoundedRectStyle style;
+    style.fillMode = FillMode::LinearGradient;
+    style.gradientDirection = GradientDirection::Horizontal;
+    style.gradientStops = {
+        GradientStop{0.0F, withAlpha(primary, alpha)},
+        GradientStop{0.34F, withAlpha(primary, alpha)},
+        GradientStop{0.66F, withAlpha(secondary, alpha)},
+        GradientStop{1.0F, withAlpha(secondary, alpha)},
+    };
+    style.softness = glow ? 2.0F : 1.0F;
+    style.radius = glow ? 3.0F : 1.0F;
+    return style;
+  }
