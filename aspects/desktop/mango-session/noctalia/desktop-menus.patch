+// R39a: one hover snapshot from the native compositor model, never mmsg polling.
+void WorkspacesWidget::previewHover(InputArea* area, std::string_view event) {
+  if (!m_hoverPreview) return;
+  auto& router = scripting::PluginIpcRouter::instance();
+  if (event == "leave") {
+    (void)router.dispatch("nix-dotfiles/desktop-menus:control all leave");
+    return;
+  }
+  const auto it = std::ranges::find(m_items, area, &Item::area);
+  if (it == m_items.end() || it->exiting) return;
+  const auto* output = m_platform.findOutputByWl(it->output);
+  if (output == nullptr) return;
+  auto windows = nlohmann::json::array();
+  for (const auto& w : m_platform.workspaceWindowAssignments(it->output)) {
+    if (w.workspaceKey != it->workspace.id) continue;
+    const auto identity = app_identity::resolveRunningDesktopEntry(w.appId, desktopEntries());
+    windows.push_back({{"id", w.windowId}, {"appId", w.appId},
+                       {"app", identity.name.empty() ? w.appId : identity.name}, {"title", w.title}});
+  }
+  float x = 0, y = 0;
+  Node::absolutePosition(area, x, y);
+  nlohmann::json context = {{"workspace", it->label}, {"key", it->workspace.id},
+      {"output", output->connectorName}, {"x", x + area->width() * 0.5F},
+      {"width", output->effectiveLogicalWidth()}, {"height", output->effectiveLogicalHeight()},
+      {"windows", windows}};
+  (void)router.dispatch("nix-dotfiles/desktop-menus:control all hover " + context.dump());
 }
 
