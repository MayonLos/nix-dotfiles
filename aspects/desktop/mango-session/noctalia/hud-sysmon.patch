+      panel.metrics.push_back(TooltipMetric{.key = std::string(key), .value = std::move(*value), .color = color});
+    }
+  };
+  addMetric(SysmonStat::CpuUsage, "CPU");
+  addMetric(SysmonStat::CpuFreq, "频率");
+  addMetric(SysmonStat::CpuTemp, "温度", fixedColorSpec(rgbHex(0xD19A66)));
+  addMetric(SysmonStat::RamUsed, "内存");
+  addMetric(SysmonStat::RamPct, "占用", fixedColorSpec(rgbHex(0x98C379)));
+  addMetric(SysmonStat::SwapPct, "Swap");
+  addMetric(SysmonStat::NetRx, "↓", colorSpecFromRole(ColorRole::Secondary));
+  addMetric(SysmonStat::NetTx, "↑", fixedColorSpec(rgbHex(0xE5C07B)));
+  const bool gpuOnline = stats.gpuUsagePercent.has_value() || stats.gpuTempC.has_value()
+      || (stats.gpuVramUsedBytes.has_value() && stats.gpuVramTotalBytes.has_value());
+  panel.metrics.push_back(TooltipMetric{.key = "独显", .value = gpuOnline ? formatValueFor(SysmonStat::GpuUsage, stats).value_or("在线") : "不可用"});
