+TooltipPanel SysmonWidget::buildSystemTooltip() const {
+  // HUD27: all sysmon widgets share one SYSTEM panel with a CPU history graph and metric grid.
+  const SystemStats stats = m_monitor != nullptr && m_monitor->isRunning() ? m_monitor->latest() : SystemStats{};
+  TooltipPanel panel;
+  panel.title = "SYSTEM";
+  if (const auto uptime = systemUptime(); uptime.has_value()) {
+    const auto totalMinutes = std::chrono::duration_cast<std::chrono::minutes>(*uptime).count();
+    const auto days = totalMinutes / (24 * 60);
+    const auto hours = (totalMinutes / 60) % 24;
+    const auto minutes = totalMinutes % 60;
+    panel.summary = days > 0 ? std::format("↑ {}d {}h{}m", days, hours, minutes) : std::format("↑ {}h{}m", hours, minutes);
+  } else {
+    panel.summary = "UPTIME · --";
+  }
+
+  const auto addMetric = [this, &panel, &stats](SysmonStat stat, std::string_view key,
+                            std::optional<ColorSpec> color = std::nullopt) {
+    if (!statAvailableForTooltip(stat, stats)) return;
@@ -1161,5 +1175,24 @@
