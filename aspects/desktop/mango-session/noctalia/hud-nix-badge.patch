+
+void PluginWidget::luaSetBadge(bool visible) {
+  if (m_badge != nullptr && m_badge->visible() != visible) {
+    m_badge->setVisible(visible);
+    m_dirty = true;
+  }
+}
+
+void PluginWidget::luaSetMinWidth(float width) {
+  if (m_label != nullptr) {
+    m_label->setMinWidth(std::max(0.0F, width) * m_contentScale);
+    m_dirty = true;
+  }
+}
+
+void PluginWidget::luaResetState() {
+  luaSetBadge(false);
+  luaSetMinWidth(0.0F);
+}
 
