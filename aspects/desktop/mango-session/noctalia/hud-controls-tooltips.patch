+  // HUD27: give the selected bar tools readable headings without changing the plugin API.
+  std::string title;
+  if (m_entryId.starts_with("fel/quill:")) title = "QUILL";
+  else if (m_entryId.starts_with("8bury/mini-docker:")) title = "DOCKER";
+  else if (m_entryId.starts_with("rxtsel/portctl:")) title = "PORTS";
+  else if (m_entryId.starts_with("mindnbytes/nix-status:")) title = "NIXOS";
+  if (!title.empty()) {
+    TooltipPanel panel;
+    panel.title = std::move(title);
+    if (tooltip.hasRows()) {
+      for (const auto& row : tooltip.rows) {
+        const bool numeric = !row.value.empty() && row.value.find_first_not_of("0123456789") == std::string::npos;
+        if (numeric) panel.metrics.push_back({.key = row.key, .value = row.value});
+        else panel.rows.push_back({.key = row.key, .value = row.value});
+      }
+    } else {
+      std::size_t start = 0;
+      while (start < tooltip.text.size()) {
+        const auto end = tooltip.text.find(" · ", start);
+        const auto value = tooltip.text.substr(start, end == std::string::npos ? end : end - start);
+        if (value != "NixOS") panel.rows.push_back({.value = value});
+        if (end == std::string::npos) break;
+        start = end + std::string(" · ").size();
+      }
+    }
+    m_area->setTooltip(std::move(panel));
+    return;
+  }
