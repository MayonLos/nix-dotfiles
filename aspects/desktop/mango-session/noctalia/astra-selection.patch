+std::unique_ptr<Flex> HomeTab::createCompactControls() {
+  const float scale = contentScale();
+  auto controls = ui::column({.align = FlexAlign::Stretch, .gap = Style::spaceXs * scale});
+  const auto addSlider = [this, scale,
+                          &controls](const std::string& title, Slider** slider, Label** value, bool volume) {
+    auto row = ui::row({.align = FlexAlign::Center, .gap = Style::spaceSm * scale});
+    row->addChild(
+        ui::label(
+            {.text = title,
+             .fontSize = Style::fontSizeCaption * scale,
+             .color = colorSpecFromRole(ColorRole::OnSurfaceVariant),
+             .width = 36.0F * scale}
+        )
+    );
+    row->addChild(
+        ui::slider({
+            .out = slider,
+            .minValue = volume || m_config == nullptr ? 0.0 : m_config->config().brightness.minimumBrightness,
+            .maxValue = 1.0,
+            .step = 0.01,
+            .value = 0.0,
+            .trackHeight = 4.0F * scale,
+            .thumbSize = 14.0F * scale,
+            .controlHeight = 28.0F * scale,
+            .flexGrow = 1.0F,
+            .onValueChanged =
+                [this, value, volume](double v) {
+                  if (*value != nullptr)
+                    (*value)->setText(std::format("{}%", static_cast<int>(std::lround(v * 100.0))));
+                  if (!m_syncingCompact && volume && m_audio != nullptr)
+                    m_audio->setVolume(static_cast<float>(v));
+                },
+            .onDragEnd =
+                [this, slider, volume]() {
+                  if (!volume && *slider != nullptr && m_brightness != nullptr) {
+                    m_brightness->setAllBrightness(static_cast<float>((*slider)->value()));
+                    m_compactBrightnessHoldUntil = std::chrono::steady_clock::now() + std::chrono::milliseconds(180);
+                  }
+                },
+        })
+    );
+    row->addChild(
+        ui::label(
+            {.out = value,
+             .text = "0%",
+             .fontSize = Style::fontSizeCaption * scale,
+             .color = colorSpecFromRole(ColorRole::OnSurface),
+             .width = 38.0F * scale,
+             .textAlign = TextAlign::End}
+        )
+    );
+    controls->addChild(std::move(row));
+  };
+  addSlider("音量", &m_compactVolume, &m_compactVolumeValue, true);
+  addSlider("亮度", &m_compactBrightness, &m_compactBrightnessValue, false);
+  syncCompactControls();
+  return controls;
+}
+
+void HomeTab::syncCompactControls() {
+  m_syncingCompact = true;
+  if (m_compactVolume != nullptr) {
+    const auto* sink = m_audio != nullptr ? m_audio->defaultSink() : nullptr;
+    m_compactVolume->setEnabled(sink != nullptr && sink->available);
+    if (sink != nullptr && !m_compactVolume->dragging()) {
+      m_compactVolume->setValue(std::clamp(sink->volume, 0.0F, 1.0F));
+      m_compactVolumeValue->setText(
+          sink->muted ? "静音" : std::format("{}%", static_cast<int>(std::lround(sink->volume * 100.0F)))
+      );
+    }
+  }
+  if (m_compactBrightness != nullptr) {
+    const BrightnessDisplay* display = nullptr;
+    if (m_brightness != nullptr) {
+      for (const auto& candidate : m_brightness->displays()) {
+        if (candidate.controllable) {
+          display = &candidate;
+          break;
+        }
+      }
+    }
+    m_compactBrightness->setEnabled(display != nullptr);
+    if (display != nullptr
+        && !m_compactBrightness->dragging()
+        && std::chrono::steady_clock::now() >= m_compactBrightnessHoldUntil) {
+      m_compactBrightness->setValue(display->brightness);
+      m_compactBrightnessValue->setText(
+          std::format("{}%", static_cast<int>(std::lround(display->brightness * 100.0F)))
+      );
+    }
+  }
+  m_syncingCompact = false;
 }

