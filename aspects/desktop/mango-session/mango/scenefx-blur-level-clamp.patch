 void main() {
     vec2 uv = v_texcoord / 2.0;
 
-    vec4 sum = texture2D(tex, uv + vec2(-halfpixel.x * 2.0, 0.0) * radius);
+    vec4 sum = sample_level(uv + vec2(-halfpixel.x * 2.0, 0.0) * radius);
 
