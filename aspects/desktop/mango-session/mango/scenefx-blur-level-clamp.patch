 uniform float radius;
 uniform vec2 halfpixel;
+// The pyramid occupies only the top-left part of a full-size texture.
+// GL_CLAMP_TO_EDGE clamps to the allocation, not the populated level.
+#ifdef GL_FRAGMENT_PRECISION_HIGH
+#define SAMPLING_PRECISION highp
+#else
+#define SAMPLING_PRECISION mediump
+#endif
+uniform SAMPLING_PRECISION vec4 sample_bounds;
+
+vec4 sample_level(SAMPLING_PRECISION vec2 uv) {
+    return texture2D(tex, clamp(uv, sample_bounds.xy, sample_bounds.zw));
+}
 
 void main() {
     vec2 uv = v_texcoord * 2.0;
 
-    vec4 sum = texture2D(tex, uv) * 4.0;
-    sum += texture2D(tex, uv - halfpixel.xy * radius);
-    sum += texture2D(tex, uv + halfpixel.xy * radius);
-    sum += texture2D(tex, uv + vec2(halfpixel.x, -halfpixel.y) * radius);
-    sum += texture2D(tex, uv - vec2(halfpixel.x, -halfpixel.y) * radius);
+    vec4 sum = sample_level(uv) * 4.0;
+    sum += sample_level(uv - halfpixel.xy * radius);
+    sum += sample_level(uv + halfpixel.xy * radius);
+    sum += sample_level(uv + vec2(halfpixel.x, -halfpixel.y) * radius);
+    sum += sample_level(uv - vec2(halfpixel.x, -halfpixel.y) * radius);
 
     gl_FragColor = sum / 8.0;
 }
