 static void render_blur_segments(struct fx_gles_render_pass *pass,
-		struct fx_render_blur_pass_options *fx_options, struct blur_shader* shader) {
+		struct fx_render_blur_pass_options *fx_options, struct blur_shader* shader,
+		int source_level) {
 	struct fx_render_texture_options *tex_options = &fx_options->tex_options;
 	struct wlr_render_texture_options *options = &tex_options->base;
 	struct fx_renderer *renderer = pass->buffer->renderer;
@@ -884,6 +885,16 @@
 
 	glUniform1i(shader->tex, 0);
 	glUniform1f(shader->radius, blur_data->radius);
+
+	// Clamp every tap to texel centers of the populated pyramid level.
+	// Offscreen buffers keep the full output size at every level; sampling
+	// outside the scaled region otherwise reads stale pixels from another pass.
+	const float width = options->texture->width;
+	const float height = options->texture->height;
+	const int divisor = 1 << source_level;
+	glUniform4f(shader->sample_bounds, 0.5f / width, 0.5f / height,
+			(ceilf(width / divisor) - 0.5f) / width,
+			(ceilf(height / divisor) - 0.5f) / height);
 
 	if (shader == &renderer->shaders.blur1) {
 		glUniform2f(shader->halfpixel,
@@ -1056,14 +1067,14 @@
