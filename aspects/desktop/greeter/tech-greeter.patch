+  // UI v4: Lenovo exposes conservation separately from standard battery limits.
+  int techConservationMode() {
+    int result = -1;
+    bool conflict = false;
+    std::error_code ec;
+    for (std::filesystem::directory_iterator it("/sys/bus/platform/drivers/ideapad_acpi", ec), end;
+         !ec && it != end; it.increment(ec)) {
+      std::string mode;
+      std::ifstream modeFile(it->path() / "conservation_mode");
+      std::getline(modeFile, mode);
+      if (mode != "0" && mode != "1") continue;
+      const int current = mode == "1" ? 1 : 0;
+      if (result != -1 && result != current) conflict = true;
+      result = current;
+    }
+    return ec || conflict ? -1 : result;
+  }
+
+  // UI v4: public machine telemetry only, cached to avoid frame-time sysfs IO.
+  std::string techMachineStatus() {
+    static std::string cached;
+    static auto refreshed = std::chrono::steady_clock::time_point{};
+    const auto now = std::chrono::steady_clock::now();
+    if (!cached.empty() && now - refreshed < std::chrono::seconds(5)) return cached;
+    refreshed = now;
+    utsname system{};
+    cached = uname(&system) == 0
+        ? std::string(system.nodename) + " · " + system.sysname + " " + system.release
+        : "system unavailable";
+    const int conservation = techConservationMode();
+    std::string care = conservation == 1 ? " · 养护开" : conservation == 0 ? " · 养护关" : " · 养护 --";
+    std::error_code ec;
+    for (std::filesystem::directory_iterator it("/sys/class/power_supply", ec), end;
+         !ec && it != end; it.increment(ec)) {
+      const auto& entry = *it;
+      std::string type, state;
+      std::ifstream(entry.path() / "type") >> type;
+      if (type != "Battery") continue;
+      // Conservation is independent of whether capacity can be read.
+      int capacity = -1, threshold = -1;
+      std::ifstream(entry.path() / "charge_control_end_threshold") >> threshold;
+      if (conservation < 0) care = threshold > 0 && threshold <= 80 ? " · 养护开"
+          : threshold > 80 && threshold <= 100 ? " · 养护关" : " · 养护 --";
+      std::ifstream(entry.path() / "capacity") >> capacity;
+      std::ifstream(entry.path() / "status") >> state;
+      if (capacity < 0 || capacity > 100) break;
+      cached += " · BAT " + std::to_string(capacity) + "% ";
+      for (int i = 0; i < 10; ++i) cached += i * 10 < capacity ? "▰" : "▱";
+      cached += " " + state;
+      break;
+    }
+    cached += care;
+    return cached;
+  }
+
+  RoundedRectStyle techGradient(float alpha, float radius = 1.0f, float softness = 1.0f) {
+    const auto blue = colorForRole(ColorRole::Primary, alpha);
+    const auto cyan = colorForRole(ColorRole::Secondary, alpha);
+    RoundedRectStyle style;
+    style.fillMode = FillMode::LinearGradient;
+    style.gradientDirection = GradientDirection::Horizontal;
+    style.gradientStops = {{{0.0f, blue}, {0.33f, lerpColor(blue, cyan, 0.33f)},
+                            {0.66f, lerpColor(blue, cyan, 0.66f)}, {1.0f, cyan}}};
+    style.radius = Radii(radius);
+    style.softness = softness;
+    return style;
+  }
