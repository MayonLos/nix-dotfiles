QWidget {
  color: @BRIGHT_FG@;
}

QDialog, QMainWindow, QWidget#centralWidget { background: @BG@; }

QPushButton, QToolButton, QComboBox, QSpinBox, QDoubleSpinBox {
  color: @BRIGHT_FG@;
  background: @SURFACE@;
  border: 1px solid @SELECTION@;
  border-radius: 6px;
  padding: 4px 9px;
  min-height: 18px;
}
QPushButton:hover, QToolButton:hover, QComboBox:hover { background: @SELECTION@; }
QPushButton:pressed, QToolButton:pressed { background: @DEEP@; color: @BLUE@; }
QPushButton:focus, QToolButton:focus, QComboBox:focus, QSpinBox:focus,
QDoubleSpinBox:focus, QLineEdit:focus { border-color: @BLUE@; }
QPushButton:default { border-color: @BLUE@; }
QPushButton:disabled, QToolButton:disabled, QComboBox:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled {
  color: @MUTED@;
  background: @SURFACE@;
  border-color: @SELECTION@;
}

QCheckBox, QRadioButton { spacing: 8px; padding: 2px 0; }
QGroupBox::indicator, QCheckBox::indicator, QRadioButton::indicator {
  width: 14px;
  height: 14px;
  background: @DEEP@;
  border: 1px solid @MUTED@;
}
QGroupBox::indicator, QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 8px; }
QGroupBox::indicator:hover, QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: @BLUE@; }
QGroupBox::indicator:checked, QCheckBox::indicator:checked {
  background: @BLUE@;
  border-color: @BLUE@;
  image: url(@CHECKMARK@);
}
QGroupBox::indicator:indeterminate, QCheckBox::indicator:indeterminate {
  background: @SELECTION@;
  border-color: @BLUE@;
  image: url(@INDETERMINATE@);
}
QRadioButton::indicator:checked {
  background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.4, fx: 0.5, fy: 0.5,
                              stop: 0 @BLUE@, stop: 0.7 @BLUE@, stop: 0.71 @DEEP@, stop: 1 @DEEP@);
  border: 1px solid @BLUE@;
}
QGroupBox::indicator:disabled, QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
  background: @SURFACE@;
  border-color: @SELECTION@;
}
QGroupBox::indicator:checked:disabled, QCheckBox::indicator:checked:disabled {
  background: @SELECTION@;
  border-color: @SELECTION@;
  image: url(@CHECKMARK_DISABLED@);
}
QGroupBox::indicator:indeterminate:disabled, QCheckBox::indicator:indeterminate:disabled {
  background: @SELECTION@;
  border-color: @SELECTION@;
  image: url(@INDETERMINATE_DISABLED@);
}
QRadioButton::indicator:checked:disabled {
  background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.4, fx: 0.5, fy: 0.5,
                              stop: 0 @MUTED@, stop: 0.7 @MUTED@, stop: 0.71 @SURFACE@, stop: 1 @SURFACE@);
  border: 1px solid @SELECTION@;
}
QGroupBox:disabled, QCheckBox:disabled, QRadioButton:disabled { color: @MUTED@; }

QLineEdit, QTextEdit, QPlainTextEdit {
  color: @BRIGHT_FG@;
  background: @DEEP@;
  border: 1px solid @SELECTION@;
  border-radius: 6px;
  padding: 5px 8px;
  selection-background-color: @SELECTION@;
  selection-color: @BRIGHT_FG@;
}
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
  color: @MUTED@;
  background: @SURFACE@;
  border-color: @SELECTION@;
}

QAbstractItemView {
  color: @BRIGHT_FG@;
  background: @DEEP@;
  alternate-background-color: @BG@;
  border: 1px solid @SELECTION@;
  selection-background-color: @SELECTION@;
  selection-color: @BRIGHT_FG@;
  outline: 0;
}
QAbstractItemView::item { padding: 4px; border-left: 2px solid transparent; }
QAbstractItemView::item:selected { background: @SELECTION@; border-left-color: @BLUE@; }

QTabWidget::pane { border: 1px solid @SELECTION@; background: @BG@; }
QTabBar::tab {
  color: @FG@;
  background: @DEEP@;
  border: 0;
  border-bottom: 2px solid transparent;
  padding: 6px 11px;
}
QTabBar::tab:selected { color: @BRIGHT_FG@; background: @BG@; border-bottom-color: @BLUE@; }
QTabBar::tab:hover { background: @SURFACE@; }

QHeaderView::section {
  color: @FG@;
  background: @DEEP@;
  border: 0;
  border-bottom: 1px solid @SELECTION@;
  padding: 6px;
  font-family: "@FONT_MONO@";
  font-size: 11px;
}
QGroupBox {
  color: @FG@;
  background: @BG@;
  border: 1px solid @SELECTION@;
  border-radius: 6px;
  margin-top: 12px;
  padding: 10px 8px 8px;
}
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: @FG@; }

QMenu { color: @BRIGHT_FG@; background: @SURFACE@; border: 1px solid @SELECTION@; padding: 4px; }
QMenu::item { padding: 5px 20px; }
QMenu::item:selected { background: @SELECTION@; }
QMenu::item:disabled { color: @MUTED@; }

QScrollBar:vertical { background: @DEEP@; width: 8px; margin: 0; }
QScrollBar:horizontal { background: @DEEP@; height: 8px; margin: 0; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: @SELECTION@; min-width: 24px; min-height: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }

QProgressBar { color: @BRIGHT_FG@; background: @DEEP@; border: 0; text-align: center; }
QProgressBar::chunk { background: @SELECTION@; border-bottom: 2px solid @BLUE@; }
QStatusBar { background: @DEEP@; font-family: "@FONT_MONO@"; font-size: 11px; }
QToolTip { color: @BRIGHT_FG@; background: @SURFACE@; border: 1px solid @SELECTION@; padding: 5px; }
