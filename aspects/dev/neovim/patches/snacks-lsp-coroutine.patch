@@ -4,6 +4,22 @@
 ---@module 'uv'
 
 local M = {}
+
+-- LSP handlers run on Neovim's main loop, not the finder coroutine.
+-- Convert responses there (locations_to_items uses main-loop APIs), then
+-- deliver the collected items after request():wait() resumes the finder.
+local function async_finder(find)
+  return function(cb)
+    local items = {}
+    find(function(item)
+      items[#items + 1] = item
+    end)
+    for _, item in ipairs(items) do
+      cb(item)
+    end
+  end
+end
+
 
