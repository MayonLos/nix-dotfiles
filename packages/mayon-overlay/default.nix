{
  pkgs,
  # Fonts are palette data (Inter / Noto Sans CJK SC); callers may override.
  inter ? pkgs.inter,
  # Noto Sans CJK 2.004 in nixpkgs is a variable CFF2 collection that
  # fontdue cannot outline; Maple Mono NF CN is the palette mono font and
  # ships static TrueType glyphs, so it is the default CJK fallback.
  cjkFont ? pkgs.maple-mono.NF-CN,
}:
let
  palette = import ../../aspects/appearance/appearance/onedark.nix;
  runtimePath = pkgs.lib.makeBinPath [
    pkgs.cliphist
    pkgs.wl-clipboard
    pkgs.wtype
    pkgs.glib
    pkgs.libnotify
    pkgs.fontconfig
    pkgs.coreutils
  ];
in
pkgs.rustPlatform.buildRustPackage {
  pname = "mayon-overlay";
  version = "0.1.0";

  # Only this directory is a build input. Excluding target/, .work/ and VCS
  # metadata keeps local builds and dirty worktrees out of the store path.
  src = pkgs.lib.cleanSourceWith {
    src = ./.;
    filter =
      path: type:
      let
        base = builtins.baseNameOf path;
      in
      pkgs.lib.cleanSourceFilter path type
      && !(builtins.elem base [
        "target"
        ".work"
        "result"
        "result-bin"
      ]);
  };

  cargoLock.lockFile = ./Cargo.lock;

  # Palette constants are generated by build.rs from the repository's single
  # source of truth; editing onedark.nix rebuilds the overlay.
  MAYON_OVERLAY_PALETTE = builtins.toJSON palette;

  nativeBuildInputs = [
    pkgs.makeWrapper
    pkgs.pkg-config
  ];
  buildInputs = [
    pkgs.wayland
    pkgs.libxkbcommon
  ];

  postInstall = ''
    # One binary, three entry points: the raw binary plus the two key-binding
    # wrappers used by the desktop session.
    wrapProgram $out/bin/mayon-overlay \
      --prefix PATH : ${runtimePath} \
      --set-default MAYON_OVERLAY_FONT ${inter}/share/fonts/truetype/InterVariable.ttf \
      --set-default MAYON_OVERLAY_FONT_FALLBACK ${cjkFont}/share/fonts/truetype/MapleMono-NF-CN-Regular.ttf
    makeWrapper $out/bin/mayon-overlay $out/bin/mayon-clipboard --add-flags clipboard
    makeWrapper $out/bin/mayon-overlay $out/bin/mayon-launcher --add-flags launcher
  '';

  meta = {
    description = "Wayland layer-shell clipboard history and text application launcher";
    homepage = "https://github.com/nix-dotfiles/nix-dotfiles";
    license = pkgs.lib.licenses.mit;
    mainProgram = "mayon-overlay";
    platforms = pkgs.lib.platforms.linux;
  };
}
