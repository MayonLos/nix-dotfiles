+    /// 【应用设置】【上传兼容】旧 JSON 只使用 uploader 分组时保存上传字段仍写回原组，不产生重复 upload 字段
+    #[test]
+    fn upload_edits_stay_in_the_existing_legacy_group() {
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().join("config.json");
+        std::fs::write(&path, r#"{"uploader":{"command":"old.sh"}}"#).unwrap();
+        write(
+            &path,
+            &[("upload.timeout_ms".into(), serde_json::json!(90000))],
+        )
+        .unwrap();
+        let root = source(&path).unwrap();
+        assert!(root.get("upload").is_none());
+        assert_eq!(root["uploader"]["timeout_ms"], 90000);
+        assert_eq!(root["uploader"]["command"], "old.sh");
+    }
 }
